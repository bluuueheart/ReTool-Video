# Copy this file to .env in the directory from which you run ReTool-Video.
MODEL_BASE_PATH=./models

# Inference budgets
MAX_RECURSION_DEPTH=5
MAX_ITERATIONS=15
RESOLVER_MAX_SEARCH_ROUNDS=3
PLANNER_MAX_GENERATION_TOKENS=24576
SUBAGENT_MAX_GENERATION_TOKENS=2048

# Set this to cpu to run Whisper without CUDA.
PREPROCESS_ASR_DEVICE=cuda

# To disable execution of model-generated Python:
# DISABLED_TOOL_NAMES_BASE='["Python_Executor"]'

# Optional OpenAI-compatible planner endpoint:
# LLM_PROVIDER=openai
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
